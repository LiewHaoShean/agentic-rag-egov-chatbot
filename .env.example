# ============================================================
#  Agentic RAG E-Government Chatbot — environment template
#  Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
MAX_PAYLOAD_BYTES=256000

# ---- Gemini (agent brain / reasoning) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# ---- DashScope (Qwen3-VL vision/OCR + Qwen ASR) ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TIMEOUT_SECONDS=60

# ---- Embeddings: e5-large-instruct, STRICTLY 1024 dims ----
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
# Primary: Alibaba embedding API
ALIBABA_EMBEDDING_API_KEY=
ALIBABA_EMBEDDING_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/embeddings
ALIBABA_EMBEDDING_MODEL=text-embedding-v3
# Fallback: HuggingFace Inference API (cold-start/503 prone for this model)
HF_API_KEY=
HF_EMBEDDING_URL=https://api-inference.huggingface.co/models/intfloat/multilingual-e5-large-instruct

# ---- Supabase (Postgres + pgvector + Storage) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=whatsapp-media

# ---- Redis (Celery broker + idempotency dedupe store) ----
REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=21600

# ---- Webhook security ----
WEBHOOK_TOKEN=

# ---- n8n outbound callback ----
N8N_CALLBACK_URL=
N8N_CALLBACK_TIMEOUT_SECONDS=15
N8N_CALLBACK_MAX_RETRIES=5
CALLBACK_DLQ_PATH=callback_dlq.log


# ---- Langfuse observability (optional) ----
# Leave blank to disable. When empty, services/gemini.py returns no callback
# handler and no traces are emitted; the agent runs exactly as normal.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
