# ---- Secrets and environment ----
.env

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ---- OS / editor ----
.DS_Store

# ---- Tooling and tests ----
# Excluded at the author's request. Both are discussed in the report, so the
# repository will not contain code the document walks through — scripts/
# ingest_scrape.py in Section 4.5.9, scripts/eval_rag.py in Section 5.2.3, and
# the unit test suite reported case by case in Section 5.3.1.
scripts/
tests/
pytest.ini

# ---- Runtime artefacts ----
callback_dlq.log
callback_dlq.jsonl
previews/

# ---- Report and write-up (not source) ----
# The Word document is ~23 MB and changes on every save, which would bloat the
# history with binary diffs no one can read.
FYPReport.docx
~$*.docx
*.docx

# Report prose drafted alongside the code. Useful working files, but they belong
# to the document rather than to the system.
report-*.md
appendix-*.txt
DEPLOY.md

# ---- Evaluation output ----
# Regenerated by scripts/eval_rag.py. The harness and the question set are
# tracked; their output is not, since it is reproducible and the reported
# figures live in the report itself.
eval_*.csv
eval_*.csv.bak
eval_*_review.md
*.eval
